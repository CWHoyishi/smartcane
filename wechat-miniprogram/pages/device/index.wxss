/* 设备管理页面 */
.container { padding: 32rpx; min-height: 100vh; box-sizing: border-box; }

.section-title { font-size: 30rpx; font-weight: 600; color: #1D2129; margin-bottom: 20rpx; margin-top: 32rpx; }

/* 统计概览 */
.stats-row { display: flex; gap: 20rpx; margin-bottom: 40rpx; }
.stat-card {
  flex: 1;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}
.stat-number { font-size: 48rpx; font-weight: bold; line-height: 1.2; margin-bottom: 8rpx; }
.stat-label { font-size: 22rpx; color: #86909C; }

/* 设备卡片 */
.device-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  margin-bottom: 20rpx;
}
.card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.device-sn { font-size: 34rpx; font-weight: 600; color: #4E6EF2; }
.card-body { display: flex; flex-wrap: wrap; }
.info-item { width: 50%; display: flex; flex-direction: column; margin-bottom: 12rpx; }
.info-label { font-size: 22rpx; color: #86909C; margin-bottom: 8rpx; }
.info-value { font-size: 28rpx; color: #1D2129; }

/* 按钮本身用 app.wxss 的 .btn-primary / .btn-plain，这里只管间距 */
.bind-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 40rpx;
}

.empty-tip { text-align: center; padding: 120rpx 0; color: #86909C; font-size: 28rpx; }
