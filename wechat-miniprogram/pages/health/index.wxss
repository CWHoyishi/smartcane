/* 健康统计页面 */
.container { padding: 32rpx; min-height: 100vh; box-sizing: border-box; }

/* 切换栏 */
.top-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.mode-switch { display: flex; background-color: #FFFFFF; border-radius: 48rpx; padding: 6rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08); }
.mode-item { padding: 10rpx 36rpx; font-size: 26rpx; color: #86909C; border-radius: 40rpx; }
.mode-active { background-color: #4E6EF2; color: #FFFFFF; }
.range-text { font-size: 22rpx; color: #86909C; }

/* 概览卡片 */
.summary-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.summary-card {
  width: 328rpx;
  box-sizing: border-box;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}
.summary-label { font-size: 24rpx; color: #86909C; }
.summary-line { display: flex; align-items: baseline; margin-top: 12rpx; }
.summary-value { font-size: 44rpx; font-weight: 600; }
.summary-unit { font-size: 22rpx; color: #86909C; margin-left: 8rpx; }
.value-hr { color: #FF6B6B; }
.value-spo2 { color: #4E6EF2; }
.value-warn { color: #FF9F1C; }
.value-ok { color: #2BB673; }

/* 趋势图 */
.card {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}
.card-title { font-size: 28rpx; font-weight: 600; color: #1D2129; margin-bottom: 16rpx; }

/* 绘图区尺寸与 index.js 里的 CHART_W / CHART_H 必须一致 */
.chart-plot { position: relative; width: 620rpx; height: 220rpx; border-bottom: 1rpx solid #E5E6EB; }
.chart-line {
  position: absolute;
  height: 4rpx;
  border-radius: 2rpx;
  background-color: #FF6B6B;
  transform-origin: 0 50%;
}
.line-spo2 { background-color: #4E6EF2; }
.chart-dot { position: absolute; width: 10rpx; height: 10rpx; border-radius: 50%; background-color: #FF6B6B; }
.dot-spo2 { background-color: #4E6EF2; }
.chart-bar { position: absolute; bottom: 0; border-radius: 4rpx 4rpx 0 0; }
.bar-warn { background-color: #FF9F1C; }
.bar-ok { background-color: #2BB673; }
.chart-empty { position: absolute; left: 0; right: 0; top: 90rpx; text-align: center; font-size: 24rpx; color: #C9CDD4; }
.chart-axis { display: flex; justify-content: space-between; margin-top: 12rpx; }
.chart-axis text { font-size: 22rpx; color: #86909C; }

/* 明细 */
.row { padding: 20rpx 0; border-bottom: 1rpx solid #F2F3F5; }
.row:last-child { border-bottom: none; }
.row-period { font-size: 26rpx; color: #1D2129; font-weight: 600; }
.row-metrics { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.row-metric { font-size: 22rpx; color: #86909C; margin-right: 24rpx; }

.tip { padding: 0 8rpx 32rpx; }
.tip text { font-size: 22rpx; color: #86909C; line-height: 1.6; }

.empty-tip { text-align: center; padding: 60rpx 0; color: #86909C; font-size: 26rpx; }
.error-tip { text-align: center; padding: 80rpx 40rpx; color: #FF6B6B; font-size: 26rpx; background-color: rgba(255,107,107,0.05); border-radius: 12rpx; margin-top: 24rpx; }