/* 实时监测页面样式 */
.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 设备选择器 */
.device-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.device-label { font-size: 24rpx; color: #86909C; }
.device-name { font-size: 28rpx; font-weight: 500; color: #4E6EF2; margin-top: 8rpx; }
.switch-btn { font-size: 24rpx; color: #4E6EF2; padding: 8rpx 16rpx; }

/* 刷新状态栏 */
.refresh-bar { text-align: right; margin-bottom: 16rpx; }
.refresh-text { font-size: 22rpx; color: #86909C; }

/* 传感器卡片网格 */
.sensor-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.sensor-card {
  width: calc(50% - 12rpx);
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}
.card-header { display: flex; align-items: center; margin-bottom: 20rpx; }
.card-icon { font-size: 36rpx; margin-right: 12rpx; }
.card-title { font-size: 24rpx; color: #86909C; }
.value-row { display: flex; align-items: baseline; }
.card-value { font-size: 48rpx; font-weight: bold; line-height: 1.2; }
.card-unit { font-size: 24rpx; color: #86909C; margin-left: 8rpx; }

/* 位置信息卡 */
.location-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 24rpx;
}
.location-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.location-title { font-size: 30rpx; font-weight: 600; color: #1D2129; }
.location-coords {
  background-color: #F5F7FA;
  border-radius: 8rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-around;
}
.coord-item { text-align: center; }
.coord-label { font-size: 22rpx; color: #86909C; display: block; margin-bottom: 8rpx; }
.coord-value { font-size: 34rpx; font-weight: 600; color: #36B37E; }
.no-location {
  background-color: rgba(255,125,0,0.05);
  border-radius: 8rpx;
  padding: 32rpx;
  text-align: center;
}
.no-location text { font-size: 26rpx; color: #FF7D00; }

/* 状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 40rpx;
}
.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.status-normal { background-color: rgba(54,179,126,0.1); color: #36B37E; }
.status-alert { background-color: rgba(255,107,107,0.1); color: #FF6B6B; }
.status-text { font-size: 28rpx; color: #4E5969; margin-left: 20rpx; }

/* 时间戳 */
.timestamp { text-align: center; font-size: 22rpx; color: #86909C; padding: 20rpx 0; }
