.login-page {
  padding: 160rpx 60rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #F5F6F8;
}

.login-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1D2129;
}

.login-subtitle {
  margin: 16rpx 0 80rpx;
  font-size: 26rpx;
  color: #86909C;
}

.field {
  width: 100%;
  margin-bottom: 32rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #4E5969;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background-color: #FFFFFF;
  font-size: 28rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 24rpx;
  border-radius: 12rpx;
  background-color: #4E6EF2;
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 88rpx;
}

.login-tip {
  margin-top: 40rpx;
  font-size: 22rpx;
  color: #86909C;
  text-align: center;
}